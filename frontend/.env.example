# URL directa del backend FastAPI. El backend ya habilita CORS para los
# orígenes de Vite (localhost:5173 y localhost:4173).
# Déjala vacía (VITE_NEXTCART_API_BASE_URL=) o borra este archivo para usar
# el proxy de desarrollo de Vite (vite.config.ts), que reenvía /v1 y /health.
VITE_NEXTCART_API_BASE_URL=http://localhost:8000
